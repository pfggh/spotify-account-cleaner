{
  "manifest_version": 3,
  "name": "Spotify Auto-Purge & Library Cleaner",
  "version": "4.1.0",
  "description": "1-Click automated Spotify library wipe (Liked Songs, Albums, Playlists) right from open.spotify.com.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected_interceptor.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Spotify Auto-Purge Cleaner"
  }
}
