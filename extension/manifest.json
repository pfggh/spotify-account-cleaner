{
  "manifest_version": 3,
  "name": "Spotify Auto-Purge & Library Cleaner",
  "version": "3.2.0",
  "description": "1-Click automated Spotify library wipe (Liked Songs, Albums, Playlists) right from open.spotify.com.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected_interceptor.js"],
      "matches": ["https://open.spotify.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://open.spotify.com/*", "https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Spotify Auto-Purge Cleaner"
  }
}
